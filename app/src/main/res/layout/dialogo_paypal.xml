<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg_dark">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/btnPaypalBack" android:layout_width="48dp"
            android:layout_height="48dp" android:padding="12dp"
            android:src="@drawable/icono_regresar" android:contentDescription="Volver" />
        <TextView android:id="@+id/tvPaypalHost" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="wrap_content"
            android:text="PayPal · Donación" android:textColor="@color/white" android:textSize="15sp" />
        <Button android:id="@+id/btnPaypalClose" android:layout_width="wrap_content"
            android:layout_height="48dp" android:text="Cerrar" android:textAllCaps="false"
            android:backgroundTint="@color/card_dark" android:textColor="@color/white" />
    </LinearLayout>
    <ProgressBar android:id="@+id/paypalProgress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="3dp" android:indeterminate="true" />
    <TextView android:id="@+id/tvPaypalError" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:padding="16dp" android:visibility="gone"
        android:text="No se pudo cargar PayPal. Revisa tu conexión y vuelve a intentarlo."
        android:textColor="@color/white" />
    <WebView android:id="@+id/paypalWebView" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:saveEnabled="false"
        android:importantForAutofill="noExcludeDescendants" />
</LinearLayout>
