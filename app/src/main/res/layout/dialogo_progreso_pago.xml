<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="32dp"
        android:paddingTop="48dp"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/tvPaymentStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Procesando su pago"
            android:textColor="@color/white"
            android:textSize="20sp" />

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="24dp">

            <ProgressBar
                android:id="@+id/paymentSpinner"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminateTint="@color/white" />

            <ImageView
                android:id="@+id/paymentCheck"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/icono_confirmacion_pago"
                android:importantForAccessibility="no"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnClosePaymentProgress"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:padding="8dp"
        android:background="@drawable/fondo_cerrar_pago"
        android:src="@drawable/icono_cerrar_pago"
        android:contentDescription="Cerrar"
        android:visibility="invisible" />
</FrameLayout>
