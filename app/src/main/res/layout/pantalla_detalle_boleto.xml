<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/black">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <ImageButton
            android:id="@+id/btnBackTicketDetail"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:background="@drawable/fondo_regresar_boleto"
            android:src="@drawable/icono_regresar"
            android:contentDescription="Volver a Mis Tickets"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <LinearLayout
            android:id="@+id/ticketDetailContent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:visibility="invisible"
            app:layout_constraintTop_toBottomOf="@id/btnBackTicketDetail"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintVertical_bias="1">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginTop="16dp"
                android:src="@drawable/icono_confirmacion_pago"
                android:contentDescription="Confirmación del boleto" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp">
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:padding="16dp"
                    android:background="@drawable/fondo_qr_boleto"
                    app:layout_constraintWidth_percent="0.8"
                    app:layout_constraintWidth_max="300dp"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">
                    <ImageView
                        android:id="@+id/imgTicketQr"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:src="@drawable/qr_boleto"
                        android:contentDescription="Código QR de demostración" />
                </FrameLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="Presenta este código en la entrada a la sala"
                android:textColor="@color/text_gray"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:orientation="vertical"
                android:padding="24dp"
                android:background="@drawable/fondo_informacion_boleto">

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Película" android:textColor="@color/text_gray" android:textSize="12sp" />
                <TextView android:id="@+id/tvTicketMovie"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:textColor="@color/white"
                    android:textSize="18sp" android:textStyle="bold" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="18dp" android:text="Cine"
                    android:textColor="@color/text_gray" android:textSize="12sp" />
                <TextView android:id="@+id/tvTicketCinema"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:textColor="@color/white" android:textSize="15sp" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="18dp" android:text="Fecha y hora"
                    android:textColor="@color/text_gray" android:textSize="12sp" />
                <TextView android:id="@+id/tvTicketDateTime"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:textColor="@color/white" android:textSize="15sp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="18dp" android:orientation="horizontal" android:baselineAligned="false">
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="Sala" android:textColor="@color/text_gray" android:textSize="12sp" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" android:text="Sala 5"
                            android:textColor="@color/white" android:textSize="15sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_weight="2"
                        android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="Asientos" android:textColor="@color/text_gray" android:textSize="12sp" />
                        <TextView android:id="@+id/tvTicketSeats"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" android:textColor="@color/accent_red"
                            android:textSize="17sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
