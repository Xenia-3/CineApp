<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="@color/card_dark"
    android:padding="12dp">

    <ImageView
        android:id="@+id/imgVertical"
        android:layout_width="90dp"
        android:layout_height="130dp"
        android:background="@drawable/bg_rounded_image"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTitleVertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Furiosa"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/imgVertical"
        app:layout_constraintTop_toTopOf="@+id/imgVertical" />

    <TextView
        android:id="@+id/tvGenreVertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="16dp"
        android:text="Acción"
        android:textColor="@color/text_gray"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/imgVertical"
        app:layout_constraintTop_toBottomOf="@+id/tvTitleVertical" />

    <LinearLayout
        android:id="@+id/layoutRatingVertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:background="#333333"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        app:layout_constraintStart_toEndOf="@+id/imgVertical"
        app:layout_constraintTop_toBottomOf="@+id/tvGenreVertical">

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@android:drawable/star_on"
            app:tint="#FFD700" />

        <TextView
            android:id="@+id/tvRatingVertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="4.8"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Este es el elemento que faltaba: el corazón -->
    <ImageView
        android:id="@+id/imgHeart"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/ic_favorite"
        app:layout_constraintBottom_toBottomOf="@+id/imgVertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@color/accent_red" />

</androidx.constraintlayout.widget.ConstraintLayout>